{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokmesh.dev/schemas/product-manifest-v0.1.json",
  "title": "TokMesh Lite product manifest",
  "type": "object",
  "required": ["id", "name", "version", "owner", "data", "sovereignty"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["country", "organization"],
      "properties": {
        "country": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 }
      }
    },
    "data": { "type": "object" },
    "quality": { "type": "array" },
    "sovereignty": { "type": "object" },
    "license": { "type": "string" }
  }
}

